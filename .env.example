# Copy to your host environment or .env.production; NEVER commit actual secrets.
PORT=8000
# EXACT public HTTPS origin, no trailing slash; required for secure production cookies and CSRF protection.
PUBLIC_BASE_URL=http://localhost:8000
# A persistent disk. Never put live client data in ephemeral hosting storage.
DATA_DIR=./data
# Mandatory for real public launch; choose base32 TOTP key, and enroll it in your authenticator.
REQUIRE_ADMIN_2FA=1
ADMIN_TOTP_SECRET=
# Optional: Set only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_IP_HEADERS=0
# Optional email (enable both SMTP_HOST and SMTP_FROM)
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=
# Optional Twilio transactional SMS (obtain client consent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional Stripe Hosted Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# In-process 24-hour reminders run every 30 minutes in a single application instance.
ENABLE_REMINDER_LOOP=1
